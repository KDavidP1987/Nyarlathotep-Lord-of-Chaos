expect-log \[DEV TP\] apo-s0
wait 4
chat .devwhere
expect-log \[DEV WHERE\]
chat .devunits -837329073 30
expect-log \[DEV UNITS\]
chat .devunits -837329073 400
expect-log \[DEV UNITS\]
shot full apo-spike-end
wait 10
chat .devunits -837329073 60
expect-log \[DEV UNITS\]
shot full apo-spike-end-10s
mark
chat .nyar purge
wait 2
chat .nyar purge confirm
expect-log purge
wait 20
chat .nyar status
expect-reply tracked units: 0 timeout=40
# the pathing probe: 10 fresh units at the pond walk toward apo-s0, Chaos 150 m north of the line
chat .devgo pond
expect-log \[DEV TP\] pond
wait 4
chat .nyar spawn CHAR_Undead_SkeletonSoldier_Armored_Farbane 10
expect-log spawn batch: .* 0 waiting timeout=30
wait 5
chat .devtp -1730 -1490
expect-log \[DEV TP\] to
wait 5
