# wave-sets-prep-restart.vrs: wave-sets D22 restart path, before the stop. ws-three reaches wave 2 with its units
# alive; the server is then stopped (taskkill, no /F) and started, and the boot logs "cancelled by restart", the
# boot sweep finds the units and no scoreboard is shown (checked in the logs after the boot).
# Needs: what wave-sets.vrs needs.
ensure
console TPHome
wait 3
chat .devgo pond
expect-log \[DEV TP\] pond
wait 4
console ToggleInvulnerable true
wait 2
mark
chat .nyar event start ws-three
expect-log event ws-three wave 1/3 timeout=30
wait 12
chat .devkill -1584807109 50
wait 3
chat .devkill -1584807109 50
expect-log event ws-three wave 1 cleared timeout=20
expect-log event ws-three wave 2/3 timeout=20
wait 15
chat .nyar status
expect-reply tracked units:
