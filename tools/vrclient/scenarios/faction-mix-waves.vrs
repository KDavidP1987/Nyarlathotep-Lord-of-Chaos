expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Militia_Leader_VBlood 1
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
wait 3
chat .devtp -1840 -1640
expect-log \[DEV TP\] to
wait 2
mark
wait 60
expect-no-log \[nyar\] CHAR_\S+ of \S+ died \(killer CHAR_Militia_ timeout=1
chat .devunits -63435588 60 mix-militia
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-63435588
