# faction-mix-waves-cursed.vrs: the cursed pass of faction-mix-waves.vrs alone, rerun 2026-10-16 after CHAR_Cursed_Mosquito was dropped.
ensure
console ToggleInvulnerable true
wait 2
console TPHome
wait 3
# pass cursed (allied)
chat .devgo pond
expect-log \[DEV TP\] pond
wait 5
console ToggleInvulnerable true
wait 1
chat .devmark mix-cursed
expect-log \[DEV MARK\] mix-cursed
chat .nyar spawn CHAR_Cursed_Wolf 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Cursed_ToadSpitter 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
