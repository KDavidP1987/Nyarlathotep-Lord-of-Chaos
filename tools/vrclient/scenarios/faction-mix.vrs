# faction-mix.vrs: apocalypse D37, faction mixes checked in game (step 1). Each pass spawns one unit mix with `.nyar spawn`
# (2 of each unit, 1 boss) at a site among natives of its faction, then Chaos stands 40 m off, invulnerable, for 60 s.
# An allied pass: no died line for a mix unit in those 60 s (`expect-no-log`, needs [Debug] VerboseLogging = true), every
# mix prefab still counts its spawned units; the [DEV UNIT] lines of the mix (state, target) are read from the log copy
# for the record. The native prefab's count within 80 m is logged before and after for the record only: natives that
# chased Chaos leash home (run 3: 9 then 5, no died line, every mix unit Idle with target=0), so it is not a check.
# A hostile pass (shadow: Legion Shadowkin beside undead and ghosts) expects the died line of the last unit, killed by the
# others. `.devkill` clears each mix after its checks. Passes: undead (zombie-apocalypse, undead-rising and graveyard-waves
# units with the Farbane V Blood Goreswine; CHAR_Undead_ShadowSoldier is left out: run 1 saw one kill the other at spawn),
# shadow, spider (spider-swarm, spider-hunting-grounds), bandit (bandit-ambush, roaming-hunters, bandit-reprisal,
# bandit-revenge), militia (border-watch).
# Run: --var UX= --var UZ= --var UAX= --var UAZ= (undead site and the spot 40 m off) --var UNATIVE=<native undead guid>
#      --var MX= --var MZ= --var MAX= --var MAZ= --var MNATIVE=<native militia guid>
# Needs: NyarDevTools (.devtp .devmark .devunits .devkill), DevChatEcho; Chaos invulnerable (true only).
ensure
console ToggleInvulnerable true
wait 2
console TPHome
wait 3
# pass undead (allied)
chat .devtp ${UX} ${UZ}
expect-log \[DEV TP\] to
wait 5
console ToggleInvulnerable true
wait 1
chat .devmark mix-undead
expect-log \[DEV MARK\] mix-undead
chat .nyar spawn CHAR_Undead_SkeletonSoldier_Armored_Farbane 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_ArmoredSkeletonCrossbow_Farbane 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_Guardian 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_GhostMilitia_Light 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_GhostBanshee 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_BishopOfDeath_VBlood 1
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
wait 3
chat .devunits ${UNATIVE} 80 mix-undead
expect-log \[DEV UNITS\] n=(?P<nat_undead>\d+) prefab=
chat .devtp ${UAX} ${UAZ}
expect-log \[DEV TP\] to
wait 2
mark
wait 60
expect-no-log \[nyar\] CHAR_\S+ of \S+ died timeout=1
chat .devunits -837329073 60 mix-undead
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-837329073
chat .devunits -195077008 60 mix-undead
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-195077008
chat .devunits -1967480038 60 mix-undead
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-1967480038
chat .devunits -1618703048 60 mix-undead
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-1618703048
chat .devunits -1146194149 60 mix-undead
expect-log \[DEV UNITS\] n=([2-9]|[1-9][0-9]) prefab=-1146194149
chat .devunits 577478542 60 mix-undead
expect-log \[DEV UNITS\] n=([1-9]|[1-9][0-9]) prefab=577478542
chat .devunits ${UNATIVE} 80 mix-undead
expect-log \[DEV UNITS\] n=\d+ prefab=
shot full mix-undead
chat .devtp ${UX} ${UZ}
expect-log \[DEV TP\] to
wait 3
chat .devkill -837329073 60 2
expect-log \[DEV KILL\]
chat .devkill -195077008 60 2
expect-log \[DEV KILL\]
chat .devkill -1967480038 60 2
expect-log \[DEV KILL\]
chat .devkill -1618703048 60 2
expect-log \[DEV KILL\]
chat .devkill -1146194149 60 2
expect-log \[DEV KILL\]
chat .devkill 577478542 60 1
expect-log \[DEV KILL\]
wait 3
# pass shadow (hostile)
chat .devtp ${UX} ${UZ}
expect-log \[DEV TP\] to
wait 5
console ToggleInvulnerable true
wait 1
chat .devmark mix-shadow
expect-log \[DEV MARK\] mix-shadow
chat .nyar spawn CHAR_Undead_SkeletonSoldier_Armored_Farbane 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .nyar spawn CHAR_Undead_GhostBanshee 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
mark
chat .nyar spawn CHAR_Legion_Shadowkin_Lesser 2
expect-log spawn batch: .* 0 waiting timeout=30
wait 1
chat .devtp ${UAX} ${UAZ}
expect-log \[DEV TP\] to
expect-log \[nyar\] CHAR_Legion_Shadowkin_Lesser of manual died \(killer CHAR_Undead timeout=60
shot full mix-shadow
chat .devtp ${UX} ${UZ}
expect-log \[DEV TP\] to
wait 3
chat .devkill -837329073 60 2
expect-log \[DEV KILL\]
chat .devkill -1146194149 60 2
expect-log \[DEV KILL\]
chat .devkill -1200074387 60 2
expect-log \[DEV KILL\]
wait 3
# pass spider (allied)
chat .devtp -1880 -1640
expect-log \[DEV TP\] to
wait 5
console ToggleInvulnerable true
wait 1
chat .devmark mix-spider
expect-log \[DEV MARK\] mix-spider
