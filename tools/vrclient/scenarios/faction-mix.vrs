chat .devkill 2103131615 60 2
expect-log \[DEV KILL\]
chat .devkill 574276383 60 2
expect-log \[DEV KILL\]
chat .devkill -548489519 60 1
expect-log \[DEV KILL\]
wait 3
# pass bandit (allied)
chat .devtp -1515 -1545
expect-log \[DEV TP\] to
wait 5
console ToggleInvulnerable true
wait 1
