{
  "SchemaVersion": 1,
  "events": [
    {
      "id": "legion-weekend-surge",
      "name": "Legion weekend surge",
      "enabled": false,
      "pillar": "empowerment",
      "trigger": { "type": "Schedule", "days": [ "Sat" ], "times": [ "20:00" ] },
      "durationSeconds": 1800,
      "action": {
        "type": "Empower",
        "factions": [ "Faction_Legion" ],
        "stats": { "physicalPower": 1.5, "maxHealth": 1.5 }
      },
      "announce": { "start": [ "The {faction} surge: {event}." ], "end": [ "The {faction} fall back. {event} is over." ], "warnings": false }
    },
    {
      "id": "bandit-vengeance",
      "name": "Bandit vengeance",
      "enabled": false,
      "pillar": "empowerment",
      "trigger": {
        "type": "VBloodKilled",
        "bosses": [
          "CHAR_Bandit_Bomber_VBlood", "CHAR_Bandit_Chaosarrow_VBlood", "CHAR_Bandit_Fisherman_VBlood",
          "CHAR_Bandit_Foreman_VBlood", "CHAR_Bandit_Frostarrow_VBlood", "CHAR_Bandit_Stalker_VBlood",
          "CHAR_Bandit_StoneBreaker_VBlood", "CHAR_Bandit_Tourok_VBlood"
        ]
      },
      "conditions": { "cooldownMinutes": 30 },
      "durationSeconds": 600,
      "action": {
        "type": "Empower",
        "factions": [ "Faction_Bandits" ],
        "stats": { "physicalPower": 1.3, "attackSpeed": 1.3 }
      },
      "announce": { "start": [ "The {faction} swear vengeance: {event}." ], "end": [ "The {faction} lose heart. {event} is over." ], "warnings": false }
    },
    {
      "id": "undead-nightfall",
      "name": "Undead nightfall",
      "enabled": false,
      "pillar": "empowerment",
      "trigger": { "type": "GameTime", "phase": "night" },
      "durationSeconds": 1200,
      "action": {
        "type": "Empower",
        "factions": [ "Faction_Undead" ],
        "stats": { "physicalPower": 1.25, "spellPower": 1.25 }
      },
      "announce": { "start": [ "Night falls and the {faction} stir: {event}." ], "end": [ "The {faction} settle. {event} is over." ], "warnings": false }
    },
    {
      "id": "militia-crackdown",
      "name": "Militia crackdown",
      "enabled": false,
      "pillar": "empowerment",
      "trigger": {
        "type": "VBloodKilled",
