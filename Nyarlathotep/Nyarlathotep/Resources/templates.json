      "action": {
        "type": "Empower",
        "factions": [ "Faction_Militia", "Faction_ChurchOfLum" ],
        "stats": { "maxHealth": 1.3 }
      },
      "announce": { "start": [ "The {faction} crack down: {event}." ], "end": [ "The {faction} stand down. {event} is over." ], "warnings": false }
    },
    {
      "id": "bandit-ambush",
      "name": "Bandit ambush",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "Manual" },
      "durationSeconds": 600,
      "action": {
        "type": "SpawnWaves",
        "units": [ { "prefab": "CHAR_Bandit_Thug", "count": 4 }, { "prefab": "CHAR_Bandit_Hunter", "count": 2 } ],
        "waves": 3, "intervalSeconds": 60, "radius": 10,
        "location": { "type": "Admin" }
      },
      "announce": { "start": [ "Bandits lie in wait: {event}." ], "end": [ "The bandits scatter. {event} is over." ], "warnings": false }
    },
    {
      "id": "undead-rising",
      "name": "Undead rising",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "Manual" },
      "durationSeconds": 600,
      "action": {
        "type": "SpawnWaves",
        "units": [
          { "prefab": "CHAR_Undead_SkeletonSoldier_Armored_Farbane", "count": 5 },
          { "prefab": "CHAR_Undead_ArmoredSkeletonCrossbow_Farbane", "count": 2 }
        ],
        "waves": 2, "intervalSeconds": 90, "radius": 12,
        "location": { "type": "Admin" },
        "modifiers": { "levelDelta": 2, "maxHealth": 1.2 }
      },
      "announce": { "start": [ "The dead claw their way up: {event}." ], "end": [ "The dead lie still. {event} is over." ], "warnings": false }
    },
    {
      "id": "roaming-hunters",
      "name": "Roaming hunters",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "Interval", "minMinutes": 60, "maxMinutes": 90 },
      "durationSeconds": 600,
      "action": {
        "type": "SpawnWaves",
        "units": [ { "prefab": "CHAR_Bandit_Thug", "count": 4 }, { "prefab": "CHAR_Bandit_Hunter", "count": 2 } ],
        "waves": 1, "intervalSeconds": 60, "radius": 10,
        "location": { "type": "AroundPlayer", "minDist": 20, "maxDist": 40 },
        "fanOut": { "maxInstances": 3, "minSpacing": 150 },
        "behaviour": { "type": "Hunt", "range": 45 }
      },
      "announce": { "start": [ "Hunters roam the land: {event}." ], "end": [ "The hunters scatter. {event} is over." ], "warnings": false }
    },
    {
      "id": "border-watch",
      "name": "Border watch",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "RegionEntered", "scope": [ "DunleyFarmlands" ], "playerCooldownMinutes": 30 },
      "durationSeconds": 600,
      "action": {
        "type": "SpawnWaves",
        "units": [ { "prefab": "CHAR_Militia_Light", "count": 3 }, { "prefab": "CHAR_Militia_Crossbow", "count": 2 } ],
        "waves": 1, "intervalSeconds": 60, "radius": 10,
        "location": { "type": "AroundPlayer", "minDist": 20, "maxDist": 40 },
        "behaviour": { "type": "Hunt", "range": 45 }
      },
      "announce": { "start": [ "The border watch rides out: {event}." ], "end": [ "The watch returns to its post. {event} is over." ], "warnings": false }
    },
    {
      "id": "bandit-reprisal",
      "name": "Bandit reprisal",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "FactionKills", "factions": [ "Faction_Bandits" ], "kills": 20, "windowSeconds": 300 },
      "durationSeconds": 600,
      "action": {
        "type": "SpawnWaves",
        "units": [ { "prefab": "CHAR_Bandit_Thug", "count": 4 }, { "prefab": "CHAR_Bandit_Hunter", "count": 2 } ],
        "waves": 1, "intervalSeconds": 60, "radius": 10,
        "location": { "type": "AroundPlayer", "minDist": 20, "maxDist": 40 },
        "behaviour": { "type": "Hunt", "range": 45 }
      },
      "announce": { "start": [ "The bandits want revenge: {event}." ], "end": [ "The bandits fall back. {event} is over." ], "warnings": false }
    },
    {
      "id": "graveyard-waves",
      "name": "Graveyard waves",
      "enabled": false,
      "pillar": "spawns",
      "trigger": { "type": "Manual" },
      "durationSeconds": 900,
      "action": {
        "type": "SpawnWaves",
        "waveList": [
          { "units": [
            { "prefab": "CHAR_Undead_SkeletonSoldier_Armored_Farbane", "count": 6, "modifiers": { "levelDelta": 1 } },
            { "prefab": "CHAR_Undead_ArmoredSkeletonCrossbow_Farbane", "count": 2, "modifiers": { "levelDelta": 1 } } ] },
          { "units": [
            { "prefab": "CHAR_Undead_SkeletonSoldier_Armored_Farbane", "count": 6, "modifiers": { "levelDelta": 2, "maxHealth": 1.2 } },
            { "prefab": "CHAR_Undead_ArmoredSkeletonCrossbow_Farbane", "count": 3, "modifiers": { "levelDelta": 2, "power": 1.2 } } ],
            "afterSeconds": 120, "whenCleared": true },
          { "units": [
            { "prefab": "CHAR_Undead_SkeletonSoldier_Armored_Farbane", "count": 6, "modifiers": { "levelDelta": 3, "maxHealth": 1.4, "power": 1.2 } },
            { "prefab": "CHAR_Undead_Guardian", "count": 1, "modifiers": { "level": 30, "maxHealth": 2.0, "power": 1.3 } } ],
            "whenCleared": true }
        ],
        "radius": 10,
        "location": { "type": "AroundPlayer", "minDist": 20, "maxDist": 40 },
        "behaviour": { "type": "Hunt", "range": 45 },
        "scoreboard": true
      },
      "announce": { "start": [ "The graves open: {event}." ], "end": [ "The graveyard falls silent. {event} is over." ], "warnings": false }
    }
