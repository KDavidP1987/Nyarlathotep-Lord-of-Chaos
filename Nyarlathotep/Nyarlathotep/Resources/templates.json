          "CHAR_ChurchOfLight_Sommelier_VBlood", "CHAR_Militia_BishopOfDunley_VBlood", "CHAR_Militia_Glassblower_VBlood",
          "CHAR_Militia_Guard_VBlood", "CHAR_Militia_Hound_VBlood", "CHAR_Militia_HoundMaster_VBlood",
          "CHAR_Militia_Leader_VBlood", "CHAR_Militia_Longbowman_LightArrow_Vblood", "CHAR_Militia_Nun_VBlood",
          "CHAR_Militia_Scribe_VBlood", "CHAR_ChurchOfLight_Overseer_VBlood", "CHAR_Militia_Fabian_VBlood",
          "CHAR_Villager_Tailor_VBlood", "CHAR_ChurchOfLight_Cardinal_VBlood", "CHAR_ChurchOfLight_Paladin_VBlood"
