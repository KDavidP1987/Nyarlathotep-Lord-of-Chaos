<Project Sdk="Microsoft.NET.Sdk">
	<!-- Unit tests for Nyarlathotep's pure logic. The files under ../Nyarlathotep/Logic are compiled into this
	     project directly (linked), so no game, Unity or BepInEx assembly is ever loaded (Epic S-21). -->
	<PropertyGroup>
		<TargetFramework>net6.0</TargetFramework>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>
		<LangVersion>12.0</LangVersion>
		<IsPackable>false</IsPackable>
		<IsTestProject>true</IsTestProject>
		<RootNamespace>Nyarlathotep.Tests</RootNamespace>
		<NuGetAudit>false</NuGetAudit>
		<TreatWarningsAsErrors>false</TreatWarningsAsErrors>
	</PropertyGroup>
	<ItemGroup>
		<PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
		<PackageReference Include="xunit" Version="2.9.3" />
		<PackageReference Include="xunit.runner.visualstudio" Version="2.8.2">
			<IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
			<PrivateAssets>all</PrivateAssets>
		</PackageReference>
	</ItemGroup>
	<ItemGroup>
		<Compile Include="..\Nyarlathotep\Logic\**\*.cs" Link="Logic\%(RecursiveDir)%(Filename)%(Extension)" />
		<None Include="..\Nyarlathotep\Resources\events.default.json" Link="Resources\events.default.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\Nyarlathotep\Resources\templates.json" Link="Resources\templates.json" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\Nyarlathotep\Config\Settings.cs" Link="Resources\Settings.cs.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\event-library.md" Link="Resources\event-library.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\walkable-spawns.md" Link="Resources\walkable-spawns.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\raphael-api-admin.md" Link="Resources\raphael-api-admin.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\regions.md" Link="Resources\regions.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\event-spawns.md" Link="Resources\event-spawns.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\event-spawns.md" Link="Resources\audits\event-spawns.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\automation.md" Link="Resources\automation.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\automation.md" Link="Resources\audits\automation.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\wave-sets.md" Link="Resources\wave-sets.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\wave-sets.md" Link="Resources\audits\wave-sets.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\swarm.md" Link="Resources\swarm.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\swarm.md" Link="Resources\audits\swarm.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\hunting-grounds.md" Link="Resources\hunting-grounds.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\hunting-grounds.md" Link="Resources\audits\hunting-grounds.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\revenge.md" Link="Resources\revenge.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\revenge.md" Link="Resources\audits\revenge.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\apocalypse.md" Link="Resources\apocalypse.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\apocalypse.md" Link="Resources\audits\apocalypse.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\dod\unit-watch.md" Link="Resources\unit-watch.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\audits\unit-watch.md" Link="Resources\audits\unit-watch.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\RAPHAEL_INTEGRATION_CONTRACT.md" Link="Resources\RAPHAEL_INTEGRATION_CONTRACT.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\NYARLATHOTEP_DESIGN.md" Link="Resources\NYARLATHOTEP_DESIGN.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="..\..\docs\RAPHAEL_HANDOFF_API4.md" Link="Resources\RAPHAEL_HANDOFF_API4.md" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Fixtures\human-replies-*.txt" CopyToOutputDirectory="PreserveNewest" />
		<None Include="Fixtures\region-index-size.txt" CopyToOutputDirectory="PreserveNewest" />
	</ItemGroup>
</Project>
